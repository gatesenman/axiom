{
  "name": "axiom-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Axiom desktop shell",
  "author": "Axiom",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --experimental-strip-types --test src/lib/charts.test.ts src/lib/layout.test.ts src/lib/decision.test.ts src/lib/history.test.ts src/lib/recovery.test.ts src/lib/compare.test.ts src/lib/figures.test.ts src/lib/figure-export.test.ts src/lib/figure-theme.test.ts src/lib/figure-geometry.test.ts src/lib/persist.test.ts src/lib/login-error.test.ts src/lib/sidecar-watch.test.ts electron/sidecar.test.cjs electron/supervisor.test.cjs electron/window-state.test.cjs electron/page.test.cjs",
    "e2e": "playwright test",
    "preview": "vite preview",
    "desktop": "ELECTRON_DEV=1 electron electron/main.cjs",
    "dist:dir": "npm run build && electron-builder --linux dir",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:win": "npm run build && electron-builder --win nsis zip --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg"
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.2.8",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/stix-two-text": "^5.2.8",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "@uiw/react-codemirror": "^4.25.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "i18next": "^26.4.2",
    "katex": "^0.16.22",
    "lucide-react": "^1.54.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^35.7.5",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "studio.axiom.desktop",
    "productName": "Axiom",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/axiom",
        "to": "backend/axiom",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../backend/pyproject.toml",
        "to": "backend/pyproject.toml"
      },
      {
        "from": "../vendor/windows/python",
        "to": "python",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../vendor/windows/solvers",
        "to": "solvers"
      }
    ],
    "extraFiles": [
      {
        "from": "../docs/INSTALL-WINDOWS.txt",
        "to": "INSTALL-WINDOWS.txt"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Science",
      "icon": "../assets/icon/linux"
    },
    "win": {
      "icon": "../assets/icon/axiom.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Axiom-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "公理 Axiom",
      "installerIcon": "../assets/icon/axiom.ico",
      "uninstallerIcon": "../assets/icon/axiom.ico",
      "installerHeader": "../assets/icon/installer-header.bmp",
      "installerSidebar": "../assets/icon/installer-sidebar.bmp",
      "uninstallerSidebar": "../assets/icon/uninstaller-sidebar.bmp",
      "artifactName": "Axiom-Setup-${version}-x64.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    }
  }
}
